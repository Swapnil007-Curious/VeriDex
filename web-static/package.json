{
  "name": "veridex-web",
  "private": true,
  "version": "0.1.0",
  "description": "VeriDex: structure-aware retrieval with sentence-level citation checks. Retrieval and query embedding in the browser, LLM calls through a rate-limited proxy.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/report-size.mjs",
    "preview": "npm run dev && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brand": "node scripts/brand.mjs",
    "contrast": "node scripts/contrast.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "shots": "playwright test --config playwright.shots.config.ts",
    "identity": "node scripts/export-identity.mjs",
    "smoke:identity": "node ../scripts/smoke_identity.mjs",
    "deploy": "npm run dev && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "motion": "^14.13.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "^4.162.0"
  }
}
